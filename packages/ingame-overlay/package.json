{
  "name": "@tosu/ingame-overlay",
  "version": "4.26.3",
  "description": "High performance tosu ingame overlay",
  "private": true,
  "main": "./dist/src/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "watch": "electron-vite dev --watch",
    "dist": "npm run build && electron-builder --windows",
    "build:native": "cmake -S native/linux -B native/linux/build -DCMAKE_BUILD_TYPE=Release && cmake --build native/linux/build",
    "dist:linux": "npm run build && npm run build:native && electron-builder --linux && node scripts/write-version.mjs pack/linux-unpacked"
  },
  "keywords": [],
  "author": "storycraft <me@pancake.sh>",
  "dependencies": {
    "@asdf-overlay/core": "^2.1.1",
    "@asdf-overlay/electron": "^2.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.7",
    "electron-builder-squirrel-windows": "26.15.7",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  },
  "build": {
    "productName": "tosu-ingame-overlay",
    "asar": true,
    "files": [
      "dist"
    ],
    "electronLanguages": "en-US",
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "./assets/tosu.ico"
    },
    "directories": {
      "output": "./pack/",
      "app": "."
    },
    "publish": {
      "provider": "github"
    },
    "linux": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "tosu-ingame-overlay",
      "category": "Utility",
      "extraFiles": [
        {
          "from": "native/linux/build/libtosu-overlay.so",
          "to": "hook/libtosu-overlay.so"
        },
        {
          "from": "native/linux/build/tosu_overlay.json",
          "to": "hook/tosu_overlay.json"
        },
        {
          "from": "native/linux/build/tosu-overlay-run",
          "to": "hook/tosu-overlay-run"
        }
      ]
    }
  },
  "os": [
    "win32",
    "linux"
  ]
}
