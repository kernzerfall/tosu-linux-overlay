#!/bin/sh
# Launch a game with the tosu in-game overlay loaded.
#
#   tosu-overlay-run ./osu.AppImage
#
# Works for both the OpenGL and Vulkan renderers of osu!lazer.
# For Steam / other launchers use:  /path/to/tosu-overlay-run %command%
set -e

if [ "$#" -eq 0 ]; then
    echo "usage: $0 <game> [args...]" >&2
    exit 1
fi

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
lib="$dir/libtosu-overlay.so"

if [ ! -f "$lib" ]; then
    echo "tosu-overlay-run: $lib not found" >&2
    exit 1
fi

# OpenGL path + input capture
export LD_PRELOAD="$lib${LD_PRELOAD:+ $LD_PRELOAD}"
# Vulkan path
export VK_ADD_LAYER_PATH="$dir${VK_ADD_LAYER_PATH:+:$VK_ADD_LAYER_PATH}"
export VK_INSTANCE_LAYERS="VK_LAYER_TOSU_overlay${VK_INSTANCE_LAYERS:+:$VK_INSTANCE_LAYERS}"

exec "$@"
